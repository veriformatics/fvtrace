{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "dev toolchain (npm)"
    },
    {
      "description": "lean-toolchain + the page engine's Lean runtime sources move together",
      "matchPackageNames": ["leanprover/lean4"],
      "groupName": "Lean toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Lean toolchain (lean-toolchain)",
      "managerFilePatterns": ["/^lean-toolchain$/"],
      "matchStrings": ["leanprover/lean4:v(?<currentValue>\\S+)"],
      "depNameTemplate": "leanprover/lean4",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Pinned scanner binaries (tools/tools.lock); the digest column needs a manual update",
      "managerFilePatterns": ["/^tools/tools\\.lock$/"],
      "matchStrings": [
        "(?:^|\\n)(?<depName>\\S+) (?<currentValue>\\S+) linux-x86_64 \\S+ https://github\\.com/(?<packageName>[^/]+/[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Emscripten for the page engine (tools/wasm.lock); every platform line + digest via tools/pin-wasm.sh",
      "managerFilePatterns": ["/^tools/wasm\\.lock$/"],
      "matchStrings": ["(?:^|\\n)(?<depName>emsdk) (?<currentValue>\\S+) linux-x86_64 "],
      "packageNameTemplate": "emscripten-core/emsdk",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Lean runtime sources for the page engine (tools/wasm.lock); commit + digests via tools/pin-wasm.sh",
      "managerFilePatterns": ["/^tools/wasm\\.lock$/"],
      "matchStrings": ["(?:^|\\n)(?<depName>lean-runtime) (?<currentValue>\\S+) "],
      "packageNameTemplate": "leanprover/lean4",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
