  "claims": [
    {
      "id": "C1",
      "question": "Q1",
      "subject": "S",
      "level": "descriptive",
      "text": "The well-formedness check in fvtrace check reports no violation exactly when the decoded trace is well-formed, and every violation it reports names a rule that the decoded trace breaks.",
      "needs": [
        "P1",
        "P2"
      ],
      "entailment": "E1"
    },
    {
      "id": "C2",
      "question": "Q2",
      "subject": "S",
      "level": "descriptive",
      "text": "With no what-if and without --cached, a claim reads Fully supported only when every fact it needs is verified and its evidence is unchanged since it was pinned.",
      "needs": [
        "P3",
        "T2",
        "I2"
      ],
      "entailment": "E2"
    },
    {
      "id": "C3",
      "question": "Q2",
      "subject": "S",
      "level": "descriptive",
      "text": "In a well-formed trace under a valid what-if, a claim whose reasoning fact is only human-ruled or empirical reads neither Fully supported nor Conditional.",
      "needs": [
        "P4"
      ],
      "entailment": "E3"
    },
    {
      "id": "C4",
      "question": "Q2",
      "subject": "S",
      "level": "descriptive",
      "text": "Claim not possible holds exactly when a need is violated, the claim needs both sides of a verified or assumed exclusion, or both sides of such an exclusion hold on the claim's subject.",
      "needs": [
        "P5"
      ],
      "entailment": "E4"
    },
    {
      "id": "C5",
      "question": "Q3",
      "subject": "S",
      "level": "descriptive",
      "text": "A planned set of experiments is prerequisite-closed, keeps the subject consistent and reports the state it reaches, and no prerequisite-closed, consistent set of experiments beats that state or matches it at strictly lower cost.",
      "needs": [
        "P6",
        "P7"
      ],
      "entailment": "E5"
    },
    {
      "id": "C6",
      "question": "Q4",
      "subject": "S",
      "level": "descriptive",
      "text": "Two what-ifs that agree on a subject's facts give each claim on that subject the same state and breakdown.",
      "needs": [
        "P8"
      ],
      "entailment": "E6"
    },
    {
      "id": "C8",
      "question": "Q2",
      "subject": "S",
      "level": "descriptive",
      "text": "A claim reads Conditional only when every reasoning, result, measurement, calculation, code and data-flow fact it needs is verified.",
      "needs": [
        "P9"
      ],
      "entailment": "E8"
    },
    {
      "id": "C7",
      "question": "Q4",
      "subject": "S",
      "level": "descriptive",
      "text": "A page from another site, or from another server on this computer, can never read the claims that fvtrace serve shows.",
      "needs": [
        "T1"
      ],
      "entailment": "E7",
      "latent": true
    },
    {
      "id": "C9",
      "question": "Q5",
      "subject": "S",
      "level": "descriptive",
      "text": "The indexed paths that fvtrace runs give the same answers as the plain definitions: every answer about a scenario, every question that the checker, the lints and the receipt statements ask of a trace, and the member order of the canonical form.",
      "needs": [
        "P10",
        "P11",
        "P12"
      ],
      "entailment": "E9"
    }
  ],
