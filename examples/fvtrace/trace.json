      "entailment": "E4"
    },
    {
      "id": "C5",
      "question": "Q3",
      "subject": "S",
      "level": "descriptive",
      "text": "A planned set of experiments is prerequisite-closed, keeps the subject consistent and reports the state it reaches, and no prerequisite-closed, consistent set of experiments beats that state or matches it at strictly lower cost.",
      "needs": [
        "P6",
        "P7"
      ],
      "entailment": "E5"
    },
    {
      "id": "C6",
      "question": "Q4",
      "subject": "S",
      "level": "descriptive",
      "text": "Two what-ifs that agree on a subject's facts give each claim on that subject the same state and breakdown.",
      "needs": [
