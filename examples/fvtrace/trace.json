{
  "fvtrace": 1,
  "analysis": {
    "id": "fvtrace",
    "title": "fvTrace",
    "summary": "What fvTrace itself can claim about its checker and engine. Seven claims rest on Lean proofs of the code fvTrace runs; two wait on code that is tested, not proved. Like every analysis, it takes its instruments on trust without listing them per claim: here the Lean and C compilers that build that code."
  },
  "subjects": [
    {
      "id": "S",
      "title": "fvTrace 0.1.0",
      "kind": "existing"
    }
  ],
  "questions": [
    {
      "id": "Q1",
      "title": "Checking",
      "text": "Does fvtrace check accept exactly the traces that fvTrace can evaluate?"
    },
    {
      "id": "Q2",
      "title": "Verdicts",
      "text": "When fvTrace gives a verdict, does it rest on what the trace records?"
    },
    {
      "id": "Q3",
      "title": "Plans",
      "text": "Are suggested plans the best that the suggested experiments allow?"
    },
    {
      "id": "Q4",
      "title": "Isolation",
      "text": "Can a what-if or another site reach claims it should not touch?"
    },
    {
      "id": "Q5",
      "title": "Fast paths",
      "text": "Does the fast evaluation that fvtrace runs give the answers that the proved definitions give?"
    }
  ],
